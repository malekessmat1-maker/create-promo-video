{
  "name": "hadal-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "20-second 3D promo film for HADAL, rendered with Remotion + react-three-fiber",
  "scripts": {
    "dev": "remotion studio",
    "render": "npm run render:landscape && npm run render:portrait",
    "render:landscape": "remotion render src/index.ts PromoLandscape out/hadal-ad-landscape.mp4 --gl=angle",
    "render:portrait": "remotion render src/index.ts PromoPortrait out/hadal-ad-portrait.mp4 --gl=angle",
    "soundtrack": "python3 scripts/soundtrack.py public/soundtrack.wav"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "^4.0.355",
    "@remotion/three": "^4.0.355",
    "@remotion/zod-types": "^4.0.355",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.355",
    "three": "^0.169.0",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3"
  }
}
